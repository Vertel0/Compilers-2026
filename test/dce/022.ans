export function $main() {
@l0
	%n.1 =l alloc4 4
	%nv.2 =l alloc4 4
	%c.3 =l alloc4 4
	%cmax.4 =l alloc4 4
	%mem.5 =l alloc8 8
	storew 0, %cmax.4
	storew 1, %nv.2
@l1
	%t5 =w load %nv.2
	%t4 =w csltw %t5, 10
	jnz %t4, @l2, @l3
@l2
	%t8 =w load %nv.2
	storew %t8, %n.1
	storew 0, %c.3
@l4
	%t12 =w load %n.1
	%t11 =w cnew %t12, 1
	jnz %t11, @l5, @l6
@l5
	%t15 =w load %n.1
	%t16 =w load %nv.2
	%t14 =w csltw %t15, %t16
	jnz %t14, @l7, @l8
@l7
	%t19 =w load %c.3
	%t22 =l load %mem.5
	%t23 =w load %n.1
	%t24 =l extsw %t23
	%t25 =l mul 4, %t24
	%t21 =l add %t22, %t25
	%t20 =w load %t21
	%t18 =w add %t19, %t20
	storew %t18, %c.3
	jmp @l6
@l8
	%t27 =w load %n.1
	%t26 =w and %t27, 1
	jnz %t26, @l10, @l11
@l10
	%t33 =w load %n.1
	%t31 =w mul 3, %t33
	%t30 =w add %t31, 1
	storew %t30, %n.1
	jmp @l12
@l11
	%t37 =w load %n.1
	%t36 =w div %t37, 2
	storew %t36, %n.1
@l12
	%t40 =w load %c.3
	%t39 =w add %t40, 1
	storew %t39, %c.3
	jmp @l4
@l6
	%t42 =w load %c.3
	%t44 =l load %mem.5
	%t45 =w load %nv.2
	%t46 =l extsw %t45
	%t47 =l mul 4, %t46
	%t43 =l add %t44, %t47
	storew %t42, %t43
	%t49 =w load %cmax.4
	%t50 =w load %c.3
	%t48 =w csltw %t49, %t50
	jnz %t48, @l13, @l14
@l13
	%t52 =w load %c.3
	storew %t52, %cmax.4
@l14
	%t54 =w load %nv.2
	%t53 =w add %t54, 1
	storew %t53, %nv.2
	jmp @l1
@l3
	%t57 =w load %cmax.4
	argl $glo1
	argw %t57
	%t55 =w vacall $printf
	retw 0
}
