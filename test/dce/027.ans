export function $main() {
@l0
	%i.1 =l alloc4 4
	%b.2 =l alloc8 8
	argl $glo1
	%t0 =w vacall $printf
	storew 0, %i.1
@l1
	%t5 =w load %i.1
	%t4 =w csltw %t5, 8
	jnz %t4, @l2, @l3
@l2
	%t8 =w mul 8, 4
	%t12 =l load %b.2
	%t13 =w load %i.1
	%t14 =l extsw %t13
	%t15 =l mul 4, %t14
	%t11 =l add %t12, %t15
	storew %t8, %t11
	%t17 =w load %i.1
	%t16 =w add %t17, 1
	storew %t16, %i.1
	jmp @l1
@l3
	retw 0
}
